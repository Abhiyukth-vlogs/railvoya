# RailVoya - Environment Configuration Template

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
LOG_LEVEL=info

# Brand & General Settings
BRAND_NAME=RailVoya
INTENDED_DOMAIN=railvoya.co.in
TAGLINE="Every journey, made simpler."
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Secret Keys (Change in production)
SECRET_KEY="railvoya-super-secret-dev-key-change-in-production-random-bytes"
SESSION_COOKIE_NAME="railvoya_session"
SESSION_MAX_AGE_SECONDS=2592000
COOKIE_SECURE=false

# Database Configuration
# Local development default: SQLite
DATABASE_URL="sqlite+aiosqlite:///./railvoya.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://railvoya:securepass@localhost:5432/railvoya"

# Provider Modes: "demo" or "live"
RAILWAY_PROVIDER_MODE="demo"
PAYMENT_PROVIDER_MODE="demo"

# Live Railway Provider (CRIS / Authorized Partner - Leave blank for demo mode)
LIVE_RAILWAY_API_URL=""
LIVE_RAILWAY_API_KEY=""
LIVE_RAILWAY_PARTNER_CODE=""

# Live Payment Gateway (Razorpay / Stripe / Cashfree - Leave blank for demo mode)
LIVE_PAYMENT_GATEWAY_URL=""
LIVE_PAYMENT_KEY_ID=""
LIVE_PAYMENT_KEY_SECRET=""
LIVE_PAYMENT_WEBHOOK_SECRET=""
